# ───── Переменные окружения (в панели хостинга, не в файле на GitHub!) ─────
BOT_TOKEN=токен_бота_покупателя_от_BotFather
SELLER_BOT_TOKEN=токен_бота_продавца_от_BotFather
ADMIN_ID=ваш_числовой_telegram_id
PAYMENT_INFO=Перевод по номеру +7 900 000-00-00 (Банк), получатель: Имя Ф.
TIMEZONE=Europe/Moscow

# Если панель при создании бота требует именно такое имя — поставьте то же значение, что в BOT_TOKEN:
# TELEGRAM_BOT_TOKEN=токен_бота_покупателя_от_BotFather

# Папка данных. Бот сам выберет /data (FadeHost) или /app/data (Bothost), если она есть.
# Можно задать явно:
# DB_PATH=/data/shop.db
# PHOTOS_DIR=/data/photos

# ───── По желанию (значения по умолчанию уже заданы в коде) ─────
# SURCHARGE_PERCENT=30
# SURCHARGE_FROM=2
# SURCHARGE_TO=6
# BACKUP_TIME=04:00
# RATE_LIMIT=12
# RATE_WINDOW=10
# RATE_BLOCK=30
# MAX_ACTIVE_ORDERS=3
